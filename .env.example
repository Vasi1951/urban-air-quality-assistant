# ==============================================================================
# AeroShield AI - Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application.
# Sensitive API keys must NEVER be committed to version control.

# Application Environment
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# GenAI Model Configuration (Google Gemini / OpenAI compatible)
# Supports Gemini 1.5/2.0 Flash / Pro or equivalent LLM endpoints
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048

# OpenAQ / WAQI Air Quality API (Optional: fallback engine is built-in)
OPENAQ_API_KEY=your_openaq_api_key_optional
WAQI_API_TOKEN=your_waqi_api_token_optional

# Security & Rate Limiting Configurations
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
ENABLE_PII_SCRUBBING=true
ENABLE_PROMPT_FIREWALL=true
COARSE_GEO_PRECISION_DIGITS=1

# Caching Configuration
AQI_CACHE_TTL_SECONDS=900
RECOMMENDATION_CACHE_TTL_SECONDS=1800

